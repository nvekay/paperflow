{
  "name": "paperflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "description": "Invoice processing with n8n and custom code: Claude reads PDFs and scans, code checks the numbers, a person approves what is uncertain, results land in Google Sheets",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:n8n": "docker compose up -d --wait",
    "down": "docker compose down",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
