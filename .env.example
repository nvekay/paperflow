# Claude reads the invoices; without a key the app uses a keyless fake that returns sample data
ANTHROPIC_API_KEY=
# The first model reads every document; the second re-reads only those that look unreliable
EXTRACT_MODEL=claude-haiku-5-5
FALLBACK_MODEL=claude-sonnet-5-5

# Web app (apps/web). The values below match docker-compose.yml for local development; production sets its own.
DATABASE_URL=postgres://paperflow:paperflow@localhost:5434/paperflow
WEB_URL=http://localhost:3000
# n8n calls the app's API with this bearer token
PAPERFLOW_API_KEY=local-paperflow-api-key
# The intake workflow's webhook and the header secret it checks
N8N_INTAKE_URL=http://localhost:5678/webhook/paperflow-intake
N8N_WEBHOOK_SECRET=local-n8n-webhook-secret
# Signs the review links sent to Slack
REVIEW_SECRET=local-review-link-secret
# Public read-only link to the Google Sheet the workflow writes to (optional)
SHEET_URL=
DEMO_LIMIT_PER_HOUR=10
DEMO_LIMIT_PER_DAY=300
CRON_SECRET=

# n8n (docker compose locally, environment variables on Render). Without Slack and Google the review and recording
# steps fail and say so on the demo page.
# Slack app with the chat:write bot scope, invited to the review channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Google service account with the Sheets API enabled; share the sheet with its email as Editor
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
