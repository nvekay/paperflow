    {
      "parameters": {
        "content": "## Intake\nThe app stores the upload and calls this webhook. The Paperflow node has Claude read the invoice, code checks the numbers and decides whether a person must look at it. Every step is reported back to the demo page.",
        "height": 520,
        "width": 900,
        "color": 7
      },
      "id": "8cfacd8d-40ee-4915-a606-754544d6b386",
      "name": "Note: intake",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ]
    },
    {
      "parameters": {
        "content": "### Thresholds\nChange **Settings** to approve larger invoices automatically or to demand less certainty. Nothing is ever rejected without a person.",
        "height": 200,
        "width": 420,
        "color": 5
      },
      "id": "0cfe64ca-a52b-43b9-a529-00e3605c4ce1",
      "name": "Note: thresholds",
